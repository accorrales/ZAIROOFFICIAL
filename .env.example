# ============================================================
#  ZAIRO backend · .env de ejemplo
#  Copiá este archivo a .env y completá los valores.
#  NUNCA subas el .env real (está en .gitignore).
# ============================================================

# --- Núcleo ---
NODE_ENV=production
PORT=3000
DATABASE_URL=
DB_POOL_MAX=10
JWT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- URLs públicas (para los QR / correos) ---
FRONTEND_PUBLIC_URL=
BACKEND_PUBLIC_URL=
ZAIRO_LOGO_URL=

# ============================================================
#  WhatsApp Business (WhatsApp Cloud API de Meta)
#
#  El módulo es OPCIONAL. Si estas 5 variables requeridas están
#  vacías, el backend arranca y funciona normal: el módulo de
#  WhatsApp queda DESACTIVADO y solo se registra un warning en logs
#  (no se envían ni reciben mensajes). Completalas cuando tengas
#  acceso a Meta for Developers para activarlo.
# ============================================================

# --- Requeridas (activan el módulo) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Opcionales (tienen valores por defecto) ---
WHATSAPP_API_VERSION=v20.0
# OCR: 'tesseract' (requiere: npm install tesseract.js) o 'stub'.
WHATSAPP_OCR_PROVIDER=tesseract
WHATSAPP_OCR_LANG=spa+eng
WHATSAPP_MONTO_TOLERANCIA=1
WHATSAPP_FECHA_TOLERANCIA_DIAS=3
WHATSAPP_MEDIA_MAX_BYTES=8388608
WHATSAPP_WEBHOOK_RATE_LIMIT=600

# ============================================================
#  Otras funcionalidades (ver los archivos de ejemplo dedicados):
#    - Apple / Google Wallet ......... .env.wallet.example
#    - Notificaciones de ubicación ... .env.locations.example
# ============================================================
