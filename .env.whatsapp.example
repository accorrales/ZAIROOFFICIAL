# ============================================================
#  Módulo WhatsApp Business (WhatsApp Cloud API de Meta)
#  Copiá estas variables a tu .env (NO subas el .env real).
# ============================================================

# --- Credenciales de Meta / WhatsApp Cloud API ---
# Token de acceso (System User token de larga duración recomendado).
WHATSAPP_ACCESS_TOKEN=
# ID del número de teléfono de WhatsApp Business (Phone Number ID).
WHATSAPP_PHONE_NUMBER_ID=
# ID de la cuenta de WhatsApp Business (WABA ID).
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token que vos definís y que Meta usa para verificar el webhook (GET).
WHATSAPP_VERIFY_TOKEN=
# App Secret de la app de Meta: valida la firma X-Hub-Signature-256 del webhook.
WHATSAPP_APP_SECRET=
# Versión de la Graph API.
WHATSAPP_API_VERSION=v20.0

# --- OCR ---
# Proveedor de OCR: 'tesseract' (por defecto) o 'stub' (sin OCR, todo a revisión).
# Para OCR real con Tesseract, instalá el paquete:  npm install tesseract.js
WHATSAPP_OCR_PROVIDER=tesseract
# Idiomas de Tesseract.
WHATSAPP_OCR_LANG=spa+eng

# --- Validación (tolerancias) ---
# Diferencia máxima de monto (colones) para considerar que coincide.
WHATSAPP_MONTO_TOLERANCIA=1
# Diferencia máxima en días entre la fecha del comprobante y la compra.
WHATSAPP_FECHA_TOLERANCIA_DIAS=3

# --- Media / seguridad ---
# Tamaño máximo del comprobante en bytes (por defecto 8 MB).
WHATSAPP_MEDIA_MAX_BYTES=8388608
# Máximo de requests al webhook por IP por minuto (defensa básica).
WHATSAPP_WEBHOOK_RATE_LIMIT=600
