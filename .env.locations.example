# Envío automático de la ubicación secreta del evento (ZAIRO LOST TRIP).
# Si está en false, el cron no envía nada (aunque sí sigue corriendo).
LOCATION_NOTIFICATIONS_ENABLED=true

# Cuántos días antes del evento se envía la ubicación por defecto.
LOCATION_SEND_DAYS_BEFORE=3

# Hora del día (0-23, hora Costa Rica) a la que se envía por defecto.
LOCATION_SEND_HOUR=10

# Cada cuántos minutos revisa el cron si hay eventos que ya cumplen la
# condición de envío. Por defecto 60 (cada hora).
LOCATION_CRON_INTERVAL_MINUTES=60
